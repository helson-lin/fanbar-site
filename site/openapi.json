{
  "openapi": "3.1.0",
  "info": {
    "title": "FanBar Product Facts API",
    "version": "1.1.0",
    "description": "A public, read-only API exposing canonical FanBar product, compatibility, installation, and safety facts.",
    "license": {
      "name": "GPL-3.0",
      "identifier": "GPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "https://getfanbar.com"
    }
  ],
  "paths": {
    "/api/product.json": {
      "get": {
        "summary": "Get canonical FanBar product facts",
        "operationId": "getFanBarProductFacts",
        "responses": {
          "200": {
            "description": "Current FanBar product facts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductFacts"
                }
              }
            }
          }
        }
      }
    },
    "/api/health.json": {
      "get": {
        "summary": "Check API publication status",
        "operationId": "getFanBarApiHealth",
        "responses": {
          "200": {
            "description": "The static API is available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductFacts": {
        "type": "object",
        "required": [
          "name",
          "summary",
          "homepage",
          "repository",
          "releases",
          "license",
          "pricing",
          "compatibility",
          "install",
          "latestRelease",
          "downloads",
          "features",
          "safety",
          "languages",
          "localizedPages",
          "updated"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "repository": {
            "type": "string",
            "format": "uri"
          },
          "releases": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          },
          "pricing": {
            "type": "object",
            "additionalProperties": true
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": true
          },
          "install": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "latestRelease": {
            "type": "object",
            "required": [
              "version",
              "publishedAt",
              "notes",
              "url"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "notes": {
                "type": "string",
                "format": "uri"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "downloads": {
            "type": "object",
            "description": "Notarized DMGs of the latest release, keyed by architecture: universal, arm64, x86_64.",
            "additionalProperties": {
              "type": "object",
              "required": [
                "name",
                "url",
                "size"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "size": {
                  "type": "integer",
                  "description": "Bytes"
                }
              }
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "safety": {
            "type": "object",
            "additionalProperties": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "localizedPages": {
            "type": "object",
            "description": "Product page URL for each BCP 47 language tag.",
            "additionalProperties": {
              "type": "string",
              "format": "uri"
            }
          },
          "updated": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "updated"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
